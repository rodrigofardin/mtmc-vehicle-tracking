# Renderizado por envsubst no start do contêiner (variáveis: BACKEND_URL, DNS_RESOLVER).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolução do backend em tempo de requisição: o frontend sobe mesmo com o backend parado.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # API REST + WebSocket (frames binários) => backend
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # config.js é gerado no start e nunca deve ser cacheado
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # assets com hash: cache longo
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: rotas da aplicação caem no index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
